# Variables de producción de SM-Xplore (P1-5).
#
# Copia este archivo a `deploy/prod/.env.prod` y reemplaza TODOS los valores.
# No se versiona ningún secreto real: si ves `cambiar-...` es un placeholder.
#
# Uso (desde la raíz del repositorio):
#   docker compose --env-file deploy/prod/.env.prod --env-file deploy/prod/images.env \
#     -f deploy/prod/compose.yaml config
#
# El compose usa `${VAR:?}` para todo lo obligatorio: si falta una variable, `docker compose`
# falla al interpolar en lugar de arrancar con un valor por defecto inseguro.

# ---------------------------------------------------------------------------------------------
# Rutas de secretos (archivos generados por el operador; ver deploy/prod/README.md)
# ---------------------------------------------------------------------------------------------
# PEM con la clave PRIVADA y la PÚBLICA del emisor JWT (ms-01 las necesita juntas).
JWT_KEYS_FILE=./secrets/jwt-keys.pem
# PEM con la clave PÚBLICA, montada en ms-02, ms-03, ms-04 y ms-05.
JWT_PUBLIC_KEY_FILE=./secrets/jwt-public.pem
# Keyfile de autenticación del replica set (deploy/mongo/gen-keyfile.sh).
MONGO_KEYFILE_FILE=./secrets/mongo-keyfile
# CA y certificado de servidor del replica set (deploy/mongo/gen-tls.sh).
MONGO_CA_FILE=./secrets/mongo-ca.pem
MONGO_SERVER_CERT_FILE=./secrets/mongo-server.pem
# Certificado TLS público (cadena completa) y su clave privada para el gateway nginx.
# Debe cubrir el hostname público (p. ej. api.smxplore.example); no uses autofirmados en producción.
GATEWAY_TLS_CERT_FILE=./secrets/gateway/tls.crt
GATEWAY_TLS_KEY_FILE=./secrets/gateway/tls.key
# Material TLS del broker Kafka (deploy/kafka/gen-tls.sh). La CA va en PEM porque kafka-exporter
# (sarama) no lee PKCS12; el broker y los servicios Java usan los PKCS12.
KAFKA_CA_FILE=./secrets/kafka/kafka-ca.crt
KAFKA_KEYSTORE_FILE=./secrets/kafka/kafka.keystore.p12
KAFKA_TRUSTSTORE_FILE=./secrets/kafka/kafka.truststore.p12

# ---------------------------------------------------------------------------------------------
# Imágenes (los 5 servicios los pinea `pin-images.sh` en images.env; aquí van los placeholders)
# ---------------------------------------------------------------------------------------------
MS01_IMAGE=ghcr.io/ivandresp/sm-xplore-ms-01@sha256:REPLACE_ME
MS02_IMAGE=ghcr.io/ivandresp/sm-xplore-ms-02@sha256:REPLACE_ME
MS03_IMAGE=ghcr.io/ivandresp/sm-xplore-ms-03@sha256:REPLACE_ME
MS04_IMAGE=ghcr.io/ivandresp/sm-xplore-ms-04@sha256:REPLACE_ME
MS05_IMAGE=ghcr.io/ivandresp/sm-xplore-ms-05@sha256:REPLACE_ME
# Infraestructura: fija versiones completas (el pin por digest se puede añadir igual que las apps).
POSTGRES_IMAGE=postgres:17-alpine
MONGO_IMAGE=mongo:8.2
REDIS_IMAGE=redis:7-alpine
NEO4J_IMAGE=neo4j:5.26-community
KAFKA_IMAGE=apache/kafka:4.1.0
KAFKA_EXPORTER_IMAGE=danielqsj/kafka-exporter:v1.9.0
POSTGRES_EXPORTER_IMAGE=prometheuscommunity/postgres-exporter:v0.17.1
REDIS_EXPORTER_IMAGE=oliver006/redis_exporter:v1.67.0
PROMETHEUS_IMAGE=prom/prometheus:v3.1.0
GATEWAY_IMAGE=nginx:1.27-alpine

# ---------------------------------------------------------------------------------------------
# Puertos host de las aplicaciones (127.0.0.1; el proxy/TLS externo los publica)
# ---------------------------------------------------------------------------------------------
MS01_PORT=8081
MS02_PORT=8080
MS03_PORT=8082
MS04_PORT=8084
MS05_PORT=8085

# Gateway: es el único que se publica fuera de loopback (80/443 por defecto). Cámbialos si el
# host ya tiene otro proxy escuchando; en ese caso apunta el proxy al puerto HTTP del gateway.
GATEWAY_HTTP_PORT=80
GATEWAY_HTTPS_PORT=443

# ---------------------------------------------------------------------------------------------
# PostgreSQL (la contraseña de ms-03 la crea deploy/postgres/01-databases.sh)
# ---------------------------------------------------------------------------------------------
POSTGRES_USER=smxplore
POSTGRES_PASSWORD=cambiar-postgres
MS03_APP_USER=ms03_app
MS03_APP_PASSWORD=cambiar-ms03-app
MS03_FLYWAY_USER=ms03_flyway
MS03_FLYWAY_PASSWORD=cambiar-ms03-flyway

# ---------------------------------------------------------------------------------------------
# MongoDB (replica set de 3 nodos con TLS; los usuarios los crea init-replica-auth.sh)
# ---------------------------------------------------------------------------------------------
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=cambiar-mongo-root
MONGO_USER_MS01=ms01_app
MONGO_PASSWORD_MS01=cambiar-mongo-ms01
MONGO_USER_MS02=ms02_app
MONGO_PASSWORD_MS02=cambiar-mongo-ms02
MONGO_USER_MS03=ms03_app
MONGO_PASSWORD_MS03=cambiar-mongo-ms03
MONGO_USER_MS04=ms04_app
MONGO_PASSWORD_MS04=cambiar-mongo-ms04

# ---------------------------------------------------------------------------------------------
# Kafka, Redis y Neo4j
# ---------------------------------------------------------------------------------------------
# Identificador del clúster KRaft. Si se cambia con datos existentes hay que volver a crear el
# volumen kafka_data (el broker falla con InconsistentClusterIdException).
KAFKA_CLUSTER_ID=4L6g3nShT-eMCtK--X86sw
# Passwords de los almacenes PKCS12 (openssl rand -hex 16). Deben coincidir con los que se pasaron
# a deploy/kafka/gen-tls.sh; si se regenera el material TLS hay que recrear el broker y todos los
# clientes a la vez.
KAFKA_KEYSTORE_PASSWORD=cambiar-keystore-kafka
KAFKA_TRUSTSTORE_PASSWORD=cambiar-truststore-kafka
# Usuario admin SCRAM-SHA-512 del broker (super usuario). Se siembra al formatear kafka_data
# (kafka-format --add-scram) y lo usan kafka-init y el healthcheck del broker.
KAFKA_ADMIN_USERNAME=admin
KAFKA_ADMIN_PASSWORD=cambiar-admin-kafka
# Usuarios SCRAM por servicio (PLAT-01): los crea kafka-init (create-acls.sh) junto con sus ACLs
# mínimas. Ver la matriz de permisos en deploy/prod/README.md.
# Password: `openssl rand -hex 16` (solo [0-9a-f]); no admite " \ ; espacios ni saltos de línea
# porque viaja dentro del valor JAAS de sasl.jaas.config.
KAFKA_MS02_USERNAME=ms-02
KAFKA_MS02_PASSWORD=cambiar-kafka-ms02
KAFKA_MS03_USERNAME=ms-03
KAFKA_MS03_PASSWORD=cambiar-kafka-ms03
KAFKA_MS04_USERNAME=ms-04
KAFKA_MS04_PASSWORD=cambiar-kafka-ms04
KAFKA_MS05_USERNAME=ms-05
KAFKA_MS05_PASSWORD=cambiar-kafka-ms05
# Operación: replay de DLQ (scripts/kafka-dlq-replay.sh).
KAFKA_DLQ_REPLAY_USERNAME=dlq-replay
KAFKA_DLQ_REPLAY_PASSWORD=cambiar-kafka-dlq-replay
# Observabilidad: kafka-exporter (solo Describe: tópicos, grupos y cluster).
KAFKA_EXPORTER_USERNAME=kafka-exporter
KAFKA_EXPORTER_PASSWORD=cambiar-kafka-exporter
REDIS_PASSWORD=cambiar-redis
NEO4J_PASSWORD=cambiar-neo4j-min-8-caracteres

# ---------------------------------------------------------------------------------------------
# Identidad y JWT (obligatorios en el perfil prod; sin JWT_ALLOW_INSECURE_JWKS)
# ---------------------------------------------------------------------------------------------
JWT_ISSUER=sm-xplore-ms-01
JWT_AUDIENCE=sm-xplore-services
# Clave AES de 32 bytes en Base64 que cifra los secretos TOTP: `openssl rand -base64 32`.
MFA_SECRET_KEY=cambiar-mfa-32-bytes-base64

# Administrador inicial. Deja BOOTSTRAP_ADMIN_ENABLED=false una vez creado el primer admin.
BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_EMAIL=admin@smxplore.example
BOOTSTRAP_ADMIN_PASSWORD=cambiar-admin-inicial
BOOTSTRAP_ADMIN_NAME=Administrador SM-Xplore

# Clave compartida del endpoint interno de contactos de ms-01 (P2-9). Solo red interna.
INTERNAL_API_KEY=cambiar-clave-interna

# Catalogo semilla de ms-04 (P3-10): false en produccion; true solo en una instalacion nueva.
CATALOG_SEED_ENABLED=false

# ---------------------------------------------------------------------------------------------
# Frontend / CORS / correo saliente opcional
# ---------------------------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=https://app.smxplore.example
FRONTEND_BASE_URL=https://app.smxplore.example
DEMAND_ZONE_ID=America/Bogota
# ms-01 usa spring.mail sin autenticación; deja un relay SMTP válido o un host local.
SMTP_HOST=localhost
SMTP_PORT=25
