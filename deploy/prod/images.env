# Imágenes de producción de SM-Xplore pineadas por digest (P1-5).
#
# Cada línea es la referencia completa `repo@sha256:...` que consume deploy/prod/compose.yaml.
# No edites este archivo a mano: regenéralo con `deploy/prod/pin-images.sh <tag>` después de
# publicar un release (`.github/workflows/release-images.yml`).
#
# Los placeholders `sha256:REPLACE_ME` hacen fallar el `docker compose pull`; es intencional,
# así nadie despliega una imagen flotante por accidente.
#
# tag de referencia: REPLACE_ME
MS01_IMAGE=ghcr.io/ivandresp/sm-xplore-ms-01@sha256:REPLACE_ME
MS02_IMAGE=ghcr.io/ivandresp/sm-xplore-ms-02@sha256:REPLACE_ME
MS03_IMAGE=ghcr.io/ivandresp/sm-xplore-ms-03@sha256:REPLACE_ME
MS04_IMAGE=ghcr.io/ivandresp/sm-xplore-ms-04@sha256:REPLACE_ME
MS05_IMAGE=ghcr.io/ivandresp/sm-xplore-ms-05@sha256:REPLACE_ME
