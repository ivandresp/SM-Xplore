# Puerto host de la API
APP_PORT=8085

# Neo4j (propiedad de ms-05)
NEO4J_PASSWORD=change-me
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_INITIALIZE_SCHEMA=true

# Seguridad RS256. Usa UNA de las dos opciones:
# 1) Produccion / ms-01: JWKS
JWT_JWK_SET_URI=
# 2) Local / pruebas: llave publica PEM (file:/ruta/public.pem o classpath:...)
JWT_PUBLIC_KEY_LOCATION=
JWT_ISSUER=
JWT_AUDIENCE=
JWT_ROLE_CLAIM=role
JWT_NAME_CLAIM=name
JWT_LANGUAGE_CLAIM=locale

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200

# Seed de datos de demo. Nunca en produccion.
SEED_ENABLED=true

# OpenAPI
SPRINGDOC_API_DOCS_ENABLED=true
SPRINGDOC_SWAGGER_UI_ENABLED=true
