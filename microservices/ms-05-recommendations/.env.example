# Puerto host de la API (se publica solo en 127.0.0.1, ver docker-compose.yml)
APP_PORT=8085

# Neo4j (propiedad de ms-05). NEO4J_PASSWORD es obligatorio: el compose falla sin el.
NEO4J_PASSWORD=change-me
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
# MS05-08: el DDL de esquema no se ejecuta por defecto. Pon true solo si necesitas
# crear constraints/indices a mano en un entorno local desechable.
NEO4J_INITIALIZE_SCHEMA=false

# Redis (infraestructura compartida en infrastructure/)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
RECOMMENDATIONS_CACHE_ENABLED=true
RECOMMENDATIONS_CACHE_KEY_PREFIX=ms05:recommendations:
RECOMMENDATIONS_CACHE_VERSION_KEY=ms05:recommendations:graph:version
RECOMMENDATIONS_CACHE_LOCAL_TTL=10s
RECOMMENDATIONS_CACHE_REDIS_TTL=1m

# Cuotas por turista (MS05-02 y MS05-04). Son por instancia y en memoria.
RECOMMENDATIONS_QUOTA_ENABLED=true
RECOMMENDATIONS_QUOTA_MAX_REQUESTS=120
RECOMMENDATIONS_QUOTA_WINDOW=1m
RECOMMENDATIONS_VIEW_QUOTA_ENABLED=true
RECOMMENDATIONS_VIEW_QUOTA_MAX_REQUESTS=60
RECOMMENDATIONS_VIEW_QUOTA_WINDOW=1m
RECOMMENDATIONS_VIEW_DEDUPE_WINDOW=1m
RECOMMENDATIONS_PREFERENCE_QUOTA_ENABLED=true
RECOMMENDATIONS_PREFERENCE_QUOTA_MAX_REQUESTS=30
RECOMMENDATIONS_PREFERENCE_QUOTA_WINDOW=1m

# Seguridad RS256. Usa UNA de las dos opciones:
# 1) Produccion / ms-01: JWKS
JWK_SET_URI=
# 2) Local / pruebas: llave publica PEM (file:/ruta/public.pem o classpath:...)
JWT_PUBLIC_KEY_LOCATION=
# MS05-10: no se acepta JWKS por HTTP salvo opt-in explicito de desarrollo local.
JWT_ALLOW_INSECURE_JWKS=false
JWT_ISSUER=sm-xplore-ms-01
JWT_AUDIENCE=sm-xplore-services
JWT_USER_ID_CLAIM=userId
JWT_ROLE_CLAIM=role
JWT_NAME_CLAIM=name

# Kafka (infraestructura compartida en infrastructure/)
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
KAFKA_CONSUMER_GROUP_ID=ms-05-recommendations
KAFKA_AUTO_OFFSET_RESET=earliest
EVENTS_CONSUMER_ENABLED=true
EVENTS_CONSUMER_MAX_RETRIES=3
EVENTS_CONSUMER_INITIAL_BACKOFF=500ms
EVENTS_CONSUMER_MAX_BACKOFF=5s
EVENTS_CONSUMER_PROCESSING_TIMEOUT=15s
EVENTS_CONSUMER_BACKOFF_MULTIPLIER=2.0
EVENTS_CONSUMER_CONCURRENCY=1
EVENTS_CONSUMER_DLQ_SUFFIX=.dlq
# MS05-01: tolerancia de reloj para occurredAt/updatedAt (maximo 1h).
EVENTS_CONSUMER_MAX_FUTURE_SKEW=5m

# Retencion de los marcadores de idempotencia (ProcessedEvent)
EVENTS_RETENTION_ENABLED=true
EVENTS_RETENTION_DAYS=30
EVENTS_RETENTION_BATCH_SIZE=1000
EVENTS_RETENTION_MAX_BATCHES=20
EVENTS_RETENTION_INTERVAL=1h

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200

# Reindexado del catalogo contra el feed de ms-04 (y actividades/eventos contra ms-03)
CATALOG_EXPORT_BASE_URL=http://localhost:8084
MS03_BASE_URL=http://localhost:8082
REINDEX_PAGE_SIZE=200
REINDEX_MAX_PAGES=500
REINDEX_TIMEOUT=30s
# MS05-03: hosts a los que se puede enviar el bearer del administrador.
REINDEX_ALLOWED_HOSTS=localhost,127.0.0.1,::1,ms-03,ms-04,host.docker.internal
REINDEX_MAX_EVENTS_PER_REQUEST=2000
REINDEX_MIN_INTERVAL=60s

# Seed de datos de demo. Nunca en produccion.
SEED_ENABLED=false

# OpenAPI. En local puedes poner true, o abrirlo con SECURITY_DOCS_PUBLIC=true.
SPRINGDOC_API_DOCS_ENABLED=false
SPRINGDOC_SWAGGER_UI_ENABLED=false
SECURITY_DOCS_PUBLIC=false
MANAGEMENT_ENDPOINTS=health,info

# Validacion de la version de autenticacion (claim ver) contra ms-01.
# MS05-06: activa por defecto; solo local/test la desactivan por no tener ms-01.
AUTH_VERSION_ENABLED=false
MS01_BASE_URL=
AUTH_VERSION_TIMEOUT=2s
AUTH_VERSION_CACHE_TTL=60s
# Exigir mfa=true a administradores
MFA_REQUIRE_ADMIN=false
