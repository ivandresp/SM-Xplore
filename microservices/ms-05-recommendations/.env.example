# Puerto host de la API
APP_PORT=8085

# Neo4j (propiedad de ms-05)
NEO4J_PASSWORD=change-me
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_INITIALIZE_SCHEMA=true

# Redis (infraestructura compartida en infrastructure/)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
RECOMMENDATIONS_CACHE_ENABLED=true
RECOMMENDATIONS_CACHE_LOCAL_TTL=10s
RECOMMENDATIONS_CACHE_REDIS_TTL=1m

# Seguridad RS256. Usa UNA de las dos opciones:
# 1) Produccion / ms-01: JWKS
JWK_SET_URI=
# 2) Local / pruebas: llave publica PEM (file:/ruta/public.pem o classpath:...)
JWT_PUBLIC_KEY_LOCATION=
# Solo desarrollo/local: acepta el JWKS por HTTP cuando el emisor no es loopback.
# En produccion debe quedar en false (el perfil prod lo exige).
JWT_ALLOW_INSECURE_JWKS=true
JWT_ISSUER=sm-xplore-ms-01
JWT_AUDIENCE=sm-xplore-services
JWT_USER_ID_CLAIM=userId
JWT_ROLE_CLAIM=role
JWT_NAME_CLAIM=name

# Kafka (infraestructura compartida en infrastructure/)
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
KAFKA_CONSUMER_GROUP_ID=ms-05-recommendations
KAFKA_AUTO_OFFSET_RESET=earliest
EVENTS_CONSUMER_ENABLED=true
EVENTS_CONSUMER_MAX_RETRIES=3
EVENTS_CONSUMER_INITIAL_BACKOFF=500ms
EVENTS_CONSUMER_MAX_BACKOFF=5s
EVENTS_CONSUMER_PROCESSING_TIMEOUT=15s
EVENTS_CONSUMER_BACKOFF_MULTIPLIER=2.0
EVENTS_CONSUMER_CONCURRENCY=1
EVENTS_CONSUMER_DLQ_SUFFIX=.dlq

# Retencion de los marcadores de idempotencia (ProcessedEvent)
EVENTS_RETENTION_ENABLED=true
EVENTS_RETENTION_DAYS=30
EVENTS_RETENTION_BATCH_SIZE=1000
EVENTS_RETENTION_MAX_BATCHES=20
EVENTS_RETENTION_INTERVAL=1h

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200

# Reindexado del catalogo contra el feed de ms-04
CATALOG_EXPORT_BASE_URL=http://localhost:8084
REINDEX_PAGE_SIZE=200
REINDEX_MAX_PAGES=500
REINDEX_TIMEOUT=30s

# Seed de datos de demo. Nunca en produccion.
SEED_ENABLED=true

# OpenAPI
SPRINGDOC_API_DOCS_ENABLED=true
SPRINGDOC_SWAGGER_UI_ENABLED=true

# Validación de la versión de autenticación (claim ver) contra ms-01.
# En prod (SPRING_PROFILES_ACTIVE=prod) se activa automáticamente; MS01_BASE_URL es obligatoria.
AUTH_VERSION_ENABLED=false
MS01_BASE_URL=
AUTH_VERSION_TIMEOUT=2s
AUTH_VERSION_CACHE_TTL=60s
# Exigir mfa=true a administradores (se activa en prod)
MFA_REQUIRE_ADMIN=false
