# Puerto host de la API
APP_PORT=8084

# MongoDB (propiedad de ms-04). Debe ser un replica set para transacciones.
MONGO_PORT=27017
MONGO_DATABASE=smxplore
MONGODB_URI=mongodb://localhost:27017/smxplore?replicaSet=rs0

# PostgreSQL (zonas y reservas)
POSTGRES_PORT=5432
POSTGRES_DB=smxplore
POSTGRES_USER=smxplore
POSTGRES_PASSWORD=change-me
POSTGRES_R2DBC_URL=r2dbc:postgresql://localhost:5432/smxplore
# Flyway abre su propia conexión JDBC para versionar el esquema
POSTGRES_JDBC_URL=jdbc:postgresql://localhost:5432/smxplore
FLYWAY_ENABLED=true
FLYWAY_BASELINE_ON_MIGRATE=true

# Seguridad RS256. Usa UNA de las dos opciones:
# 1) Producción / ms-01: JWKS
JWK_SET_URI=
# 2) Local / pruebas: llave pública PEM (file:/ruta/public.pem o classpath:...)
JWT_PUBLIC_KEY_LOCATION=
# Solo desarrollo/local: acepta el JWKS por HTTP cuando el emisor no es loopback.
# En produccion debe quedar en false (el perfil prod lo exige).
JWT_ALLOW_INSECURE_JWKS=true
JWT_ISSUER=sm-xplore-ms-01
JWT_AUDIENCE=sm-xplore-services
JWT_USER_ID_CLAIM=userId
JWT_ROLE_CLAIM=role
JWT_NAME_CLAIM=name

# Kafka (infraestructura compartida en infrastructure/)
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
KAFKA_CONSUMER_GROUP_ID=ms-04-notifications
KAFKA_AUTO_OFFSET_RESET=latest
NOTIFICATIONS_ENABLED=true

# Entrega de notificaciones por correo (canal secundario; la bandeja interna manda)
NOTIFICATIONS_EMAIL_ENABLED=false
NOTIFICATIONS_EMAIL_FROM=no-reply@smxplore.local
NOTIFICATIONS_EMAIL_SUBJECT_PREFIX=[SM-Xplore] 
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_AUTH=false
SMTP_STARTTLS=false
MAILPIT_UI_PORT=8025

# Canal push (sin proveedor externo por ahora: registra intentos y contadores)
NOTIFICATIONS_PUSH_ENABLED=false
NOTIFICATIONS_PUSH_PROVIDER=noop

# RF66: alerta de baja capacidad al cruzar el umbral de cupo restante
NOTIFICATIONS_LOW_CAPACITY_ENABLED=true
NOTIFICATIONS_LOW_CAPACITY_THRESHOLD_PERCENT=20

OUTBOX_ENABLED=true
OUTBOX_PRODUCER=ms-04
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_ATTEMPTS=20
OUTBOX_INITIAL_BACKOFF=1s
OUTBOX_MAX_BACKOFF=1m
OUTBOX_LEASE_DURATION=3m
OUTBOX_RETENTION_DAYS=30
OUTBOX_RETENTION_INTERVAL_MS=3600000

# Moderación automática de reseñas con littleLLM (OpenAI-compatible chat completions)
REVIEW_AI_ENABLED=false
LITTLELLM_URL=
LITTLELLM_API_KEY=
LITTLELLM_API_KEY_HEADER=Authorization
LITTLELLM_API_KEY_PREFIX=Bearer
LITTLELLM_MODEL=littlellm
LITTLELLM_CHAT_PATH=/v1/chat/completions
REVIEW_AI_TIMEOUT=PT5S
REVIEW_AI_THRESHOLD=0.7
REVIEW_AI_TEMPERATURE=0.0
REVIEW_AI_ACTION=PENDING_REVIEW
REVIEW_AI_FAIL_OPEN=true
REVIEW_AI_JSON_RESPONSE_FORMAT=false

# Zona horaria y política de reservas
BOOKINGS_ZONE_ID=America/Bogota
BOOKINGS_MAX_ACTIVE_PER_TOURIST=5
BOOKINGS_MAX_CREATIONS_PER_MINUTE=10
BOOKINGS_MAX_ADVANCE_DAYS=365
BOOKINGS_AUTO_COMPLETE_ENABLED=true
BOOKINGS_COMPLETION_INTERVAL_MS=60000
BOOKINGS_COMPLETION_BATCH_SIZE=100

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200

# OpenAPI
SPRINGDOC_API_DOCS_ENABLED=true
SPRINGDOC_SWAGGER_UI_ENABLED=true

# Validación de la versión de autenticación (claim ver) contra ms-01.
# En prod (SPRING_PROFILES_ACTIVE=prod) se activa automáticamente; MS01_BASE_URL es obligatoria.
AUTH_VERSION_ENABLED=false
MS01_BASE_URL=
AUTH_VERSION_TIMEOUT=2s
AUTH_VERSION_CACHE_TTL=60s
# Exigir mfa=true a administradores (se activa en prod)
MFA_REQUIRE_ADMIN=false
