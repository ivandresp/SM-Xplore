# Perfil de Spring: dev en local, prod en la imagen. Sin valor por defecto (la base es fail-closed).
# SPRING_PROFILES_ACTIVE=dev

POSTGRES_DB=smxplore_users
POSTGRES_USER=smxplore
POSTGRES_PASSWORD=smxplore
MONGO_INITDB_ROOT_USERNAME=smxplore
MONGO_INITDB_ROOT_PASSWORD=smxplore
MONGO_INITDB_DATABASE=smxplore_reviews
MONGODB_URI=mongodb://smxplore:smxplore@localhost:27017/smxplore_reviews?authSource=admin

# Seguridad de la aplicación (valores de desarrollo)
AUTH_RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_PER_MINUTE=30
# Límite por cuenta (además del límite por IP) en /auth/login y /auth/mfa/verify.
AUTH_ACCOUNT_MAX_ATTEMPTS=10
AUTH_ACCOUNT_WINDOW=PT15M
# Redes de confianza (el gateway) que pueden enviar X-Real-IP. X-Forwarded-For nunca se lee.
AUTH_TRUSTED_PROXIES=127.0.0.1/32,::1/128,172.16.0.0/12,10.0.0.0/8,192.168.0.0/16
LOGIN_LOCKOUT_ENABLED=true
LOGIN_LOCKOUT_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_WINDOW=PT15M
LOGIN_LOCKOUT_DURATION=PT15M
MFA_REQUIRED_FOR_ADMINS=false
MFA_CHALLENGE_TTL=PT5M
# Clave AES-256 (Base64) que cifra los secretos TOTP. En desarrollo se genera en .local/mfa/secret.key;
# fuera de desarrollo es obligatoria. Genérala con: openssl rand -base64 32
MFA_SECRET_KEY=
SECURITY_HSTS_ENABLED=false

# Llaves JWT (RS256) obligatorias fuera de dev. En la imagen el arranque falla si faltan
# o si se permitió generarlas. JWT_ALLOW_INSECURE_JWKS solo debe activarse en dev.
# JWT_PRIVATE_KEY=
# JWT_PUBLIC_KEY=
JWT_ALLOW_INSECURE_JWKS=false
# MS01-23: vigencia del token de acceso. Sin refresh token; la revocación por `ver` es inmediata solo en ms-01.
JWT_TTL=PT30M

# Filtro de reseñas con un LLM local compatible con OpenAI
REVIEW_AI_ENABLED=false
LITTLELLM_URL=http://localhost:8080
LITTLELLM_API_KEY=
LITTLELLM_MODEL=littlellm
REVIEW_AI_TIMEOUT=PT5S
REVIEW_AI_THRESHOLD=0.7
# 0.0 = muestreo voraz: la misma reseña produce el mismo veredicto. Subir sólo si el servidor lo recomienda.
REVIEW_AI_TEMPERATURE=0.0
REVIEW_AI_ACTION=PENDING_REVIEW
# Fail-closed en la base y en prod: si el LLM no responde, la reseña no se publica (503). El perfil dev
# lo deja en true para poder trabajar sin LLM local.
REVIEW_AI_FAIL_OPEN=false

# Retención de datos (Ley 1581). La auditoría se conserva 5 años por defecto.
RETENTION_ENABLED=true
RETENTION_AUTH_ARTIFACTS_DAYS=30
RETENTION_AUDIT_LOG_DAYS=1825
RETENTION_CRON=0 30 3 * * *

# Endpoint interno de contactos (P2-9 / MS01-11): firma HMAC por servicio, sin clave compartida en la petición.
# Clave maestra de INTERNAL_API_KEY: vacía deja /internal/** deshabilitado (responde 503).
# Cabeceras en cada llamada: X-Internal-Service, X-Internal-Timestamp (epoch s) y X-Internal-Signature
# = hex(HMAC-SHA-256(HMAC-SHA-256(claveMaestra, servicio), servicio + "\n" + método + "\n" + ruta + "\n" + timestamp)).
# Provisional: P3-8 lo reemplaza por autenticación servicio a servicio con credenciales de corta duración.
INTERNAL_API_KEY=
# Lista opcional de servicios autorizados (separados por coma). Vacía acepta cualquier servicio bien firmado.
INTERNAL_ALLOWED_SERVICES=
INTERNAL_MAX_CLOCK_SKEW=PT5M
INTERNAL_RATE_LIMIT_PER_MINUTE=60

# Fase BAJA de seguridad (MS01-13 a MS01-19).
# MS01-14: métricas y Prometheus requieren JWT; el perfil dev las publica para trabajar en local.
ACTUATOR_PUBLIC_METRICS=false
# MS01-18: verificación de correo al registrarse. Token de un solo uso con TTL de 24 h; las cuentas sin
# verificar pueden iniciar sesión pero no publicar reseñas. Al desactivarla se acepta cualquier cuenta.
EMAIL_VERIFICATION_ENABLED=true
EMAIL_VERIFICATION_TTL=PT24H
FRONTEND_VERIFY_EMAIL_PATH=/verificar-correo
# MS01-19: las contraseñas deben tener 12-72 caracteres y combinar al menos 3 de 4 clases
# (minúsculas, mayúsculas, dígitos y símbolos), y no pueden estar en la lista local de claves comunes.

# Fase informativa (MS01-22 y MS01-24).
# MS01-22: cuota de reportes de reseñas por turista (en memoria y por instancia).
REVIEW_REPORT_MAX_PER_WINDOW=20
REVIEW_REPORT_WINDOW=PT24H
# MS01-24: enfriamiento mínimo entre anomalías del mismo tipo (mitiga la fatiga de alertas).
ANOMALY_MIN_INTERVAL=PT10M