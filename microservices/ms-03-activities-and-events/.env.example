APP_PORT=8082
SERVER_PORT=8082
R2DBC_URL=r2dbc:postgresql://localhost:5432/activities_events
POSTGRES_HOST=localhost
POSTGRES_DB=activities_events
POSTGRES_ROOT_USER=postgres
POSTGRES_ROOT_PASSWORD=
POSTGRES_USER=ms03_app
POSTGRES_PASSWORD=
FLYWAY_USER=ms03_flyway
FLYWAY_PASSWORD=
POSTGRES_PORT=5432
MONGO_PORT=27017
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=
MONGO_APP_USER=reviews_app
MONGO_APP_PASSWORD=
MONGO_DATABASE=reviews
# RS256: configure JWK_SET_URI (ms-01 JWKS) or JWT_PUBLIC_KEY_LOCATION (PEM file)
JWK_SET_URI=
JWT_PUBLIC_KEY_LOCATION=
# Solo desarrollo: acepta un JWKS por HTTP cuando el emisor no es loopback (p. ej. ms-01
# dentro de Compose). En produccion debe quedar en false.
JWT_ALLOW_INSECURE_JWKS=true
JWT_ISSUER=sm-xplore-ms-01
JWT_AUDIENCE=sm-xplore-services
JWT_ROLE_CLAIM=role
JWT_NAME_CLAIM=name
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200
MONGO_AUTO_INDEX_CREATION=true
FLYWAY_URL=jdbc:postgresql://localhost:5432/activities_events
FLYWAY_ENABLED=true
RESERVATION_AUTO_CLOSE_CRON="0 15 3 * * *"
RESERVATION_AUTO_CLOSE_GRACE=P1D
SPRINGDOC_API_DOCS_ENABLED=true
SPRINGDOC_SWAGGER_UI_ENABLED=true
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
OUTBOX_ENABLED=false
OUTBOX_POLL_INTERVAL_MS=2000
# El arranque falla si batch-size x send-timeout > cycle-timeout.
OUTBOX_BATCH_SIZE=10
OUTBOX_MAX_ATTEMPTS=20
OUTBOX_INITIAL_BACKOFF=PT1S
OUTBOX_MAX_BACKOFF=PT1M
OUTBOX_LEASE_DURATION=PT3M
OUTBOX_SEND_TIMEOUT=PT5S
OUTBOX_CYCLE_TIMEOUT=PT60S
OUTBOX_RETENTION_DAYS=30
OUTBOX_RETENTION_INTERVAL_MS=3600000
SCHEDULING_POOL_SIZE=3
# Consumidor de catalog.site.changed v2 (ms-04): refresca sitio_nombre y manager_id de los eventos.
# Sin el, la gestora se revalida en caliente al responder una resena.
SITE_EVENTS_ENABLED=false
SITE_EVENTS_GROUP=ms-03-site-snapshot
SITE_EVENTS_TIMEOUT=PT10S
# Reintentos del consumidor: backoff exponencial con tope de 60 s; luego va al topic .DLT.
SITE_EVENTS_RETRY_INTERVAL_MS=1000
SITE_EVENTS_RETRY_MAX_ELAPSED_MS=60000
SITE_EVENTS_DLT_SUFFIX=.DLT

# Perfil local: obligatorio porque JWT_ALLOW_INSECURE_JWKS=true solo se acepta en local/dev/test.
SPRING_PROFILES_ACTIVE=local

# Validación de la versión de autenticación (claim ver) contra ms-01.
# En prod (SPRING_PROFILES_ACTIVE=prod) se activa automáticamente; MS01_BASE_URL es obligatoria.
AUTH_VERSION_ENABLED=false
MS01_BASE_URL=
AUTH_VERSION_TIMEOUT=2s
AUTH_VERSION_CACHE_TTL=60s
# Exigir mfa=true a administradores (se activa en prod)
MFA_REQUIRE_ADMIN=false
