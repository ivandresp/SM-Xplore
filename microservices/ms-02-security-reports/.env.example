APP_PORT=8080
MONGO_PORT=27017
MONGO_DATABASE=security_reports
JWK_SET_URI=
JWT_PUBLIC_KEY_LOCATION=
# Solo desarrollo/local: acepta el JWKS por HTTP cuando el emisor no es loopback.
# En produccion debe quedar en false (el arranque estricto lo exige).
JWT_ALLOW_INSECURE_JWKS=true
JWT_ISSUER=sm-xplore-ms-01
JWT_AUDIENCE=sm-xplore-services
JWT_USER_ID_CLAIM=userId
JWT_ROLE_CLAIM=role
JWT_NAME_CLAIM=name
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
OUTBOX_ENABLED=true
OUTBOX_PRODUCER=ms-02
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_ATTEMPTS=20
OUTBOX_INITIAL_BACKOFF=1s
OUTBOX_MAX_BACKOFF=1m
OUTBOX_LEASE_DURATION=3m
OUTBOX_RETENTION_DAYS=30
OUTBOX_RETENTION_INTERVAL_MS=3600000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200
# Limites de escritura por cuenta (MS02-03): reportes, comentarios y resto de escrituras.
REPORT_RATE_LIMIT_ENABLED=true
REPORT_RATE_LIMIT_PER_MINUTE=30
COMMENT_RATE_LIMIT_PER_MINUTE=30
WRITE_RATE_LIMIT_PER_MINUTE=60
# Proxies que pueden informar X-Real-IP (el gateway). Fuera de ellos se ignora el encabezado.
TRUSTED_PROXIES=127.0.0.1/32,::1/128,172.16.0.0/12,10.0.0.0/8,192.168.0.0/16
# Allowlist de hosts de fotos (MS02-07). En local se acepta cualquier host; en prod es obligatoria.
PHOTO_ALLOWED_HOSTS=
PHOTO_ALLOW_HTTP=true
PHOTO_ALLOW_ANY_HOST=true
# Actuator (MS02-04): por defecto solo health/info sin JWT. En local se anaden metricas.
MANAGEMENT_EXPOSED_ENDPOINTS=health,info,metrics,prometheus
MONGO_AUTO_INDEX_CREATION=true
SPRINGDOC_API_DOCS_ENABLED=true
SPRINGDOC_SWAGGER_UI_ENABLED=true

# Validacion de la version de autenticacion (claim ver) contra ms-01 (MS02-05).
# Activada por defecto fuera de local/dev/test; el perfil local la apaga.
AUTH_VERSION_ENABLED=false
MS01_BASE_URL=
AUTH_VERSION_TIMEOUT=2s
AUTH_VERSION_CACHE_TTL=60s
# Exigir mfa=true a administradores (activado por defecto fuera de local/dev/test).
MFA_REQUIRE_ADMIN=false
