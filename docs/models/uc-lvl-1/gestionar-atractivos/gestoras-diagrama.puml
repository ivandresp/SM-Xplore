@startuml

left to right direction

actor GestorasDestinos as G

package GestionarAtractivosTuristicos {
    usecase "Registrar atractivos turísticos" as UC1
    usecase "Actualizar atractivos turísticos" as UC2
    usecase "Establecer horario de disponibilidad" as UC3
    usecase "Buscar atractivo" as UC4
    usecase "Ver atractivos turísticos" as UC5
    usecase "Cambiar estado atractivo turístico" as UC6
    usecase "Asignar atractivo a zona" as UC7

    usecase "Definir capacidad atractivos turísticos" as UC8
    usecase "Ver ubicación en mapa" as UC9
    usecase "Validar existencia del atractivo" as UC10
}

G -- UC1
G -- UC2
G -- UC3
G -- UC4
G -- UC5
G -- UC6
G -- UC7

UC1 <.. UC8 : <<extends>>
UC2 <.. UC8 : <<extends>>
UC4 <.. UC9 : <<extends>>
UC5 <.. UC9 : <<extends>>

UC2 ..> UC10 : <<include>>
UC4 ..> UC10 : <<include>>
UC6 ..> UC10 : <<include>>

@enduml