@startuml

left to right direction

actor PrestadorasServicios as P

package "Gestionar Reservas (UC7)" {
    usecase "Ver reservas recibidas" as UC7_1
    usecase "Recibir notificacion de nueva reserva" as UC7_2
    usecase "Recibir alerta de baja disponibilidad" as UC7_3
    usecase "Cambiar estado de una reserva" as UC7_4
    usecase "Gestionar cancelacion por turista" as UC7_5
    usecase "Ver historial de reservas" as UC7_6
    usecase "Registrar no-show o asistencia" as UC7_7
}

P -- UC7_1
P -- UC7_2
P -- UC7_3
P -- UC7_4

UC7_4 <.. UC7_5 : <<extend>>
UC7_4 <.. UC7_7 : <<extend>>

@enduml
