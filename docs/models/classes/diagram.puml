@startuml

note "Review se relaciona con\nActividad, Evento, Guia,\nServicio,Sitio, pero poner\neso aqui revienta el modelo" as n

abstract class Usuario
class Turista
class Guia
class PrestadoraServicios
class GestoraDestinos
class Admin

class Zona
class Sitio
class Evento
class Actividad
class Servicio
class Reserva
class Review
class Anomalía
class ReporteSeguridad

Guia -right-|> Usuario
Admin -up-|> Usuario
Turista -up-|> Usuario
GestoraDestinos --|> Usuario
PrestadoraServicios -up-|> Usuario

Usuario "1  "*-up-"*" ReporteSeguridad
Usuario "1    "o-right-"0..*" Anomalía

Anomalía "0..*"--o"1" Admin

Turista "    1"-left-"*" Review
Turista "1"*--"*" Reserva

PrestadoraServicios "1"*--"*" Servicio

GestoraDestinos "1"-left-"*" Zona

Actividad "*"-right-o"1" Guia

Sitio "1"-down-"0..*  " Actividad

Zona "1"-left-"*" Sitio

Sitio "1"o-left-"*" Evento

Reserva "*"-right-*"0..1" Servicio
Reserva "*"--*"0..1" Evento
Actividad "0..1 "*--"*" Reserva

Sitio "*"-right-o"1" GestoraDestinos

@enduml