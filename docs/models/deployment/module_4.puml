@startuml
skinparam linetype ortho

node "Cliente Web"{
    artifact "Navegador" as navegador
}

node "Microservicio: Sitios, Servicios, Reservas y Reseñas" {
    package "infrastructure/adapters" {
        package "in/controllers"{
        }
        package "out/persistence"{
        }
    }
    package application{
    }
    package domain{
        package model{
        }
        package ports{
            package repository{
            }
            package "use cases"{
            }
        }
    }
    database "reservas" as DB_SQL
    database "reseñas_sitios_servicios" as DB_Mongo
    database "preferencias_sitios_servicios" as DB_Neo

    "in/controllers" --> "use cases"
    "out/persistence" ..> repository
    application ..> "use cases"
}

"out/persistence" --> DB_SQL
"out/persistence" ---> DB_Mongo
"out/persistence" --> DB_Neo

navegador --> "in/controllers"

@enduml