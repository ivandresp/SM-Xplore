{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smxplore.local/contracts/events/activities.activity.changed.v2.json",
  "title": "activities.activity.changed.v2",
  "description": "Actividad creada o modificada. Alinea el payload con el modelo de ms-03: la categoria es el nombre que el usuario escribe, no un id, y las coordenadas viven en el sitio de ms-04.",
  "allOf": [
    {
      "$ref": "./envelope.v2.json"
    },
    {
      "type": "object",
      "properties": {
        "eventType": {
          "const": "activities.activity.changed"
        },
        "eventVersion": {
          "const": 2
        },
        "payload": {
          "type": "object",
          "required": [
            "activityId",
            "siteId",
            "name",
            "category",
            "price",
            "status",
            "maxCapacity",
            "startsAt",
            "endsAt",
            "updatedAt"
          ],
          "properties": {
            "activityId": {
              "type": "string",
              "format": "uuid"
            },
            "siteId": {
              "type": "string",
              "format": "uuid"
            },
            "guideId": {
              "type": ["string", "null"],
              "format": "uuid"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 150
            },
            "category": {
              "type": "string",
              "minLength": 1,
              "maxLength": 50
            },
            "price": {
              "type": "number",
              "minimum": 0
            },
            "status": {
              "enum": ["DRAFT", "PUBLISHED", "PAUSED", "CANCELLED"]
            },
            "maxCapacity": {
              "type": "integer",
              "minimum": 1
            },
            "durationMinutes": {
              "type": "integer",
              "minimum": 0
            },
            "startsAt": {
              "type": "string",
              "format": "date-time"
            },
            "endsAt": {
              "type": "string",
              "format": "date-time"
            },
            "updatedAt": {
              "type": "string",
              "format": "date-time"
            }
          },
          "additionalProperties": false
        }
      }
    }
  ]
}
