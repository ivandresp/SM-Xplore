{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smxplore.local/contracts/events/catalog.service.changed.v1.json",
  "title": "catalog.service.changed.v1",
  "allOf": [
    {
      "$ref": "./envelope.v1.json"
    },
    {
      "type": "object",
      "properties": {
        "eventType": {
          "const": "catalog.service.changed"
        },
        "payload": {
          "type": "object",
          "required": [
            "serviceId",
            "siteId",
            "name",
            "type",
            "categoryId",
            "latitude",
            "longitude",
            "status",
            "updatedAt"
          ],
          "properties": {
            "serviceId": {
              "type": "string",
              "format": "uuid"
            },
            "siteId": {
              "type": "string",
              "format": "uuid"
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "type": {
              "type": "string",
              "minLength": 1
            },
            "categoryId": {
              "type": "string",
              "format": "uuid"
            },
            "latitude": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "longitude": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            },
            "status": {
              "enum": ["DRAFT", "PUBLISHED", "INACTIVE"]
            },
            "updatedAt": {
              "type": "string",
              "format": "date-time"
            }
          },
          "additionalProperties": false
        }
      }
    }
  ]
}
