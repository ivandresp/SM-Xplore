# SM-Xplore — variables del stack local integrado (compose.yaml raiz).
#
# Copia este archivo a .env y ajusta lo que necesites:
#
#   Copy-Item .env.example .env      (PowerShell)
#   cp .env.example .env             (bash)
#
# Todos los valores tienen un default en compose.yaml, asi que el stack arranca sin .env.
# No versiones .env: .gitignore ya lo excluye.

# --- Puertos de host (127.0.0.1) ------------------------------------------------
# Puertos no estandar para no chocar con un PostgreSQL/MongoDB local ni con los
# compose por servicio (que usan 5432 y 27017). Los contenedores se hablan por nombre.
POSTGRES_PORT=15432
MONGO_PORT=27019
KAFKA_EXTERNAL_PORT=29092
KAFKA_UI_PORT=8090
REDIS_PORT=6379
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
SMTP_PORT=1025
MAILPIT_UI_PORT=8025

MS01_PORT=8081
MS02_PORT=8080
MS03_PORT=8082
MS04_PORT=8084
MS05_PORT=8085

# --- API gateway (nginx) ---------------------------------------------------------
# Punto de entrada unico del stack: http://127.0.0.1:8088 y https://127.0.0.1:8443
# (certificado autofirmado generado por el propio gateway en un tmpfs; el contenedor no corre como root).
# Ver deploy/gateway/README.md.
GATEWAY_HTTP_PORT=8088
GATEWAY_HTTPS_PORT=8443
GATEWAY_TLS_CN=localhost

# --- Imagenes (fijar versiones o digests; nunca latest en produccion) ------------
# PLAT-13: se puede fijar el digest completo, p. ej.
#   POSTGRES_IMAGE=postgres@sha256:<64 hex>
POSTGRES_IMAGE=postgres:17-alpine
MONGO_IMAGE=mongo:8.2
KAFKA_IMAGE=apache/kafka:4.1.0
KAFKA_UI_IMAGE=provectuslabs/kafka-ui:v0.7.2
# Credenciales de la UI de Kafka (PLAT-08). Vacias = sin auth (solo loopback).
KAFKA_UI_USER=admin
KAFKA_UI_PASSWORD=kafka-ui-dev
# Mailpit: basic auth de la UI en formato usuario:password (PLAT-08).
MAILPIT_UI_AUTH=mailpit:mailpit-dev
REDIS_IMAGE=redis:7-alpine
NEO4J_IMAGE=neo4j:5.26-community
MAILPIT_IMAGE=axllent/mailpit:v1.27

# --- Credenciales de desarrollo --------------------------------------------------
# PostgreSQL: usuario administrador y roles de ms-03 (DDL / DML separados).
POSTGRES_PASSWORD=smxplore
MS03_APP_PASSWORD=ms03_app
MS03_FLYWAY_PASSWORD=ms03_flyway

# Neo4j (ms-05). Minimo 8 caracteres.
NEO4J_PASSWORD=change-me

# Administrador inicial de ms-01 (solo perfil dev).
BOOTSTRAP_ADMIN_EMAIL=admin@smxplore.local
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123!
BOOTSTRAP_ADMIN_NAME=Administrador SM-Xplore

# Clave compartida del endpoint interno de contactos de ms-01 (P2-9). Solo red interna.
INTERNAL_API_KEY=dev-internal-key

# --- Kafka -----------------------------------------------------------------------
# Identificador de cluster KRaft para desarrollo. No reutilizar en produccion.
# Ojo: una vez creado el volumen kafka_data, cambiarlo impide arrancar el broker
# (InconsistentClusterIdException). Para cambiarlo hay que hacer docker compose down -v.
KAFKA_CLUSTER_ID=4L6g3nShT-eMCtK--X86sw

# --- Aplicacion ------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200,http://localhost:5173
FRONTEND_BASE_URL=http://localhost:5173
DEMAND_ZONE_ID=America/Bogota

# Consumidor de catalog.site.changed v2 en ms-03 (refresca el snapshot de sitio).
SITE_EVENTS_ENABLED=true

# Catalogo semilla de ms-04 (P3-10): crea las categorias base si faltan. Apagado en produccion.
CATALOG_SEED_ENABLED=true

# Datos de demo en Neo4j (ms-05). Referencian ids que no existen en ms-03/ms-04.
SEED_ENABLED=false

# --- Reglas de negocio y cabeceras ---------------------------------------------
# ms-04: resenas solo de reservas COMPLETED (MS04-12). true por defecto.
REVIEW_REQUIRE_COMPLETED_BOOKING=true
# ms-01/ms-03/ms-04: si el filtro IA no responde, publicar (true) o fallar cerrado (false).
# En produccion se fuerza false (fail-closed).
REVIEW_AI_FAIL_OPEN=false
# ms-02: cabecera HSTS; solo tiene sentido detras de un terminador TLS.
HSTS_ENABLED=false
# ms-04: topic DLQ del listener de bookings.reservation.changed (MS04-11).
# Lo crea deploy/kafka/topics.env (1 particion, RF 1, 14 dias).
NOTIFICATIONS_DLQ_TOPIC=kafka.dlq.bookings.reservation.changed
